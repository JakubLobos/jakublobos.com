# ---------------------------------------------------------------------------
# Portfolio — environment variables
# Copy to `.env` (git-ignored) for local development. Never commit real values.
#
# Two deployables read these:
#   • API (Railway, apps/server): validated at startup by apps/server/src/config.ts;
#     invalid or missing values → exit 1. Set them as Railway service variables.
#   • Site (Cloudflare, apps/web): PUBLIC_* variables are read at BUILD time and are
#     embedded in client code. Never put a secret in a PUBLIC_* variable.
# See docs/architecture.md §7.
# ---------------------------------------------------------------------------

# === API (apps/server) ======================================================
# development | test | production
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
# trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# Comma-separated browser origins allowed by CORS and the POST Origin check.
# production: https://jakublobos.com   dev: http://localhost:4321   e2e/preview: http://localhost:8787
CORS_ALLOWED_ORIGINS=http://localhost:4321,http://localhost:8787

# How to determine the client IP for rate limiting:
#   socket     → TCP peer address (local development, tests)
#   x-real-ip  → header set by Railway's edge (production on Railway)
CLIENT_IP_SOURCE=socket

# SQLite file. Production: on the Railway volume, e.g. /data/portfolio.db
DATABASE_PATH=./data/portfolio.db

# --- Guestbook review (docs/guestbook-moderation.md) ------------------------
# openai | gemini | fake   ("fake" is refused when NODE_ENV=production)
MODERATION_PROVIDER=fake
SUITABILITY_PROVIDER=fake
# Secret. One dedicated OpenAI project + key; set a monthly budget limit.
OPENAI_API_KEY=
OPENAI_MODERATION_MODEL=omni-moderation-latest
OPENAI_SUITABILITY_MODEL=gpt-5-nano
# Secret. Required when a provider is "gemini" (Google AI Studio key, free tier).
# Free-tier data-use terms: docs/decisions/0016-gemini-free-tier-review-providers.md
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
MODERATION_TIMEOUT_MS=5000
SUITABILITY_TIMEOUT_MS=10000
# Reject when `flagged` OR any category score >= threshold (D-06).
MODERATION_SCORE_THRESHOLD=0.2

# --- Contact form mailer (Resend HTTPS API; SMTP is blocked on Railway Hobby) ---
# resend | console   ("console" is refused when NODE_ENV=production)
MAILER=console
# Secret.
RESEND_API_KEY=
# Must be on the Resend-verified domain, e.g. "Portfolio <contact@jakublobos.com>"
MAIL_FROM=
CONTACT_RECIPIENT_EMAIL=

# --- Phone reveal (ADR-0015) — the ONLY place the real number may exist ---
# E.164, e.g. +48XXXXXXXXX. Never commit the real value.
CONTACT_PHONE=+48000000000
# turnstile | fake   ("fake" is refused when NODE_ENV=production)
HUMAN_VERIFIER=fake
# Secret. Dev/test: Cloudflare test secret that always passes.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Hostnames accepted in the siteverify response. Production: jakublobos.com
TURNSTILE_ALLOWED_HOSTNAMES=localhost

# === Site build (apps/web, PUBLIC = embedded in client code) =================
PUBLIC_SITE_URL=http://localhost:4321
# Empty in `astro dev` (requests go to /api via the dev proxy).
# Production: https://api.jakublobos.com   e2e/preview: http://localhost:3000
PUBLIC_API_BASE_URL=
# Analytics (D-03). Leave empty to build without analytics.
PUBLIC_GA4_ID=
PUBLIC_POSTHOG_KEY=
PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
# Turnstile site key (public). Dev/test: Cloudflare test key that always passes invisibly.
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000BB

# === Deployment (CI secrets only, never in .env) ============================
# CLOUDFLARE_API_TOKEN, CLOUDFLARE_ACCOUNT_ID  → GitHub Actions secrets (wrangler deploy)
