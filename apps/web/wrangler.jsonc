{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jakublobos-com",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-15",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    // Only these paths invoke the Worker; every other request is a static asset (no Worker billing).
    // apps/web/edge-emulator reads this list, so edit it here only.
    "run_worker_first": ["/", "/set-language"],
  },
  // Custom domain, enabled at deployment (T-050/T-051):
  // "routes": [{ "pattern": "jakublobos.com", "custom_domain": true }]
}
