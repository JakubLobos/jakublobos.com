---
import { Font } from 'astro:assets';
import type { GetStaticPaths } from 'astro';
import Logo from '../components/site/Logo.astro';
import Mascot from '../components/decor/Mascot.astro';
import PaintDrips from '../components/decor/PaintDrips.astro';
import { htmlLang, isLocale, LOCALES } from '../i18n/locales.ts';
import { hero } from '../i18n/messages/hero.ts';
import { seo } from '../i18n/messages/seo.ts';
import '../styles/tokens.css';
import '../styles/base.css';

// Source of the share images: tools/og/render-og.ts screenshots this page at 1200 × 630.
export const getStaticPaths = (() =>
  LOCALES.map((locale) => ({ params: { locale } }))) satisfies GetStaticPaths;

const requested = Astro.params.locale;
const locale = isLocale(requested) ? requested : 'en';
const { og } = seo(locale);
---

<html lang={htmlLang(locale)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>OG image ({locale})</title>
    <Font cssVariable="--font-display" />
    <Font cssVariable="--font-body" />
    <Font cssVariable="--font-mono" />
  </head>
  <body>
    <main class="canvas">
      <PaintDrips variant="top" />
      <div class="logo">
        <Logo locale={locale} path="/" />
      </div>
      <div class="stage">
        <div class="mascot-box">
          <Mascot />
        </div>
        <h1 class="headline">{hero(locale).title}</h1>
        <p class="subtitle">{og.subtitle}</p>
      </div>
      <p class="domain">{og.domain}</p>
    </main>
  </body>
</html>

<style>
  .canvas {
    position: relative;
    width: 1200px;
    height: 630px;
    overflow: hidden;
    background-color: var(--color-bg);
    background-image:
      linear-gradient(var(--color-grid) 1px, transparent 1px),
      linear-gradient(90deg, var(--color-grid) 1px, transparent 1px);
    background-size: var(--grid-cell-w) var(--grid-cell-h);
  }

  .logo {
    position: absolute;
    top: var(--space-40);
    left: var(--space-56);
    transform: scale(1.25);
    transform-origin: top left;
  }

  .stage {
    position: absolute;
    inset: var(--space-64) var(--space-80) var(--space-56);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-20);
    text-align: center;
  }

  /* The mascot is a fixed 156 × 124 illustration; scale it as one unit and reserve the scaled size. */
  .mascot-box {
    width: 234px;
    height: 186px;
  }

  .mascot-box :global(.mascot) {
    transform: scale(1.5);
    transform-origin: top left;
  }

  .headline {
    margin: 0;
    font-family: var(--font-display);
    font-weight: var(--weight-regular);
    font-size: calc(var(--text-display) * 1.3);
    line-height: var(--leading-display);
    text-wrap: balance;
  }

  .subtitle {
    margin: 0;
    font-size: calc(var(--text-lead) * 1.4);
    font-weight: var(--weight-medium);
    color: var(--color-text-secondary);
  }

  .domain {
    position: absolute;
    right: var(--space-56);
    bottom: var(--space-32);
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--text-title);
    color: var(--color-text-secondary);
  }
</style>
