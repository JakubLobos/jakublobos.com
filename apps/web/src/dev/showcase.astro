---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
import ChromeButton from '../components/ui/ChromeButton.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import Highlight from '../components/ui/Highlight.astro';
import Spinner from '../components/ui/Spinner.astro';
import CheckIcon from '../components/ui/CheckIcon.astro';
import TypingField from '../components/ui/TypingField.astro';
import LanguageSwitcher from '../components/site/LanguageSwitcher.astro';
import PaintDrips from '../components/decor/PaintDrips.astro';
import CookieIcon from '../components/decor/CookieIcon.astro';
import { PAINT_ORDER } from '../lib/paints.ts';

const colours = [
  'bg',
  'surface',
  'ink',
  'text-body',
  'text-secondary',
  'text-muted',
  'text-faint',
  'line',
  'line-strong',
  'grid',
  'hover',
  'primary',
  'primary-hover',
  'primary-edge',
  'on-primary',
  'highlight',
  'on-highlight',
  'danger',
  'tech',
  'tag',
  'marker',
  'focus',
  'overlay',
  'cookie',
  'cookie-chip',
].map((n) => `--color-${n}`);
const paints = ['red', 'coral', 'yellow', 'purple', 'violet', 'blue'];
const types = [
  'display',
  'h2',
  'menu',
  'dialog-title',
  'quote',
  'h3',
  'lead',
  'title',
  'skill',
  'marquee',
  'logo',
  'modal-quote',
  'field',
  'ui',
  'body',
  'small',
  'caption',
  'label',
].map((n) => `--text-${n}`);
const spaces = [2, 4, 6, 8, 10, 12, 14, 16, 20, 22, 24, 28, 32, 36, 40, 48, 56, 64, 80].map(
  (n) => `--space-${n}`,
);
const radii = ['sm', 'md', 'lg', 'drip', 'sketch'].map((n) => `--radius-${n}`);
const quote = 'Zażółć gęślą jaźń, a quote that spans several lines of text in the guestbook';
const shadows = ['card', 'dialog', 'thumb'].map((n) => `--shadow-${n}`);
---

<BaseLayout locale="en" seoKey="home" path="/__showcase">
  <main class="container showcase">
    <h1 class="display">Token showcase</h1>
    <p class="note">Dev only. Not part of the production build.</p>

    <h2>Fonts and Polish glyphs</h2>
    <p class="f-display">JAKUB ŁOBOS ŁÓDŹ</p>
    <p class="f-body">Poppins 400: ąęśćżźńó ĄĘŚĆŻŹŃÓ Łobos</p>
    <p class="f-body f-500">Poppins 500: ąęśćżźńó Łobos</p>
    <p class="f-body f-600">Poppins 600: ąęśćżźńó Łobos</p>
    <p class="f-ui">Ubuntu 500: Menu Close ąęśćżźńó</p>
    <p class="f-mono">JetBrains Mono 400: 01 — EXPERIENCE ąęśćżźńó</p>

    <h2>Colours</h2>
    <ul class="grid">
      {colours.map((t) => (
        <li>
          <span class="swatch" data-token={t} data-prop="background"></span>
          <code>{t}</code>
        </li>
      ))}
    </ul>

    <h2>Paint palette and tints</h2>
    <ul class="grid">
      {paints.map((p) => (
        <li>
          <span class="swatch" data-token={`--paint-${p}`} data-prop="background"></span>
          <code>--paint-{p}</code>
          <span class="swatch" data-token={`--paint-${p}-tint`} data-prop="background"></span>
          <code>--paint-{p}-tint</code>
        </li>
      ))}
    </ul>

    <h2>Type ramp</h2>
    {types.map((t) => (
      <p class="ramp" data-token={t} data-prop="font-size">
        {t} — Zażółć gęślą jaźń
      </p>
    ))}

    <h2>Spacing scale</h2>
    {spaces.map((s) => (
      <div class="space-row">
        <span class="bar" data-token={s} data-prop="width"></span>
        <code>{s}</code>
      </div>
    ))}

    <h2>Radii</h2>
    <ul class="grid">
      {radii.map((r) => (
        <li>
          <span class="shape" data-token={r} data-prop="border-radius"></span>
          <code>{r}</code>
        </li>
      ))}
    </ul>

    <h2>Shadows</h2>
    <ul class="grid">
      {shadows.map((s) => (
        <li>
          <span class="shape" data-token={s} data-prop="box-shadow"></span>
          <code>{s}</code>
        </li>
      ))}
    </ul>

    <h2>Links and focus</h2>
    <p>
      <a href="#top">Tab here to see the focus ring</a> · <a href="#top">second link</a>
    </p>

    <h2>Buttons: large (links)</h2>
    <div class="row">
      <Button href="#top">Reach me out</Button>
      <Button href="#top" variant="secondary">
        Get my resume
      </Button>
    </div>

    <h2>Buttons: large (button elements)</h2>
    <div class="row">
      <Button>Primary</Button>
      <Button variant="secondary">Secondary</Button>
      <Button disabled>Disabled (aria)</Button>
      <Button variant="secondary" fullWidth>
        Full width
      </Button>
    </div>

    <h2>Buttons: contact form (idle, sending, sent)</h2>
    <div class="row">
      <Button type="submit" minWidth="form">
        Send message
      </Button>
      <Button type="submit" minWidth="form" busy>
        <Spinner />
        Sending…
      </Button>
      <Button type="submit" minWidth="form" disabled>
        <CheckIcon />
        Message sent
      </Button>
    </div>

    <h2>Buttons: small (cookie banner)</h2>
    <div class="row">
      <Button size="sm">Accept</Button>
      <Button size="sm" variant="secondary">
        Only essential
      </Button>
    </div>

    <h2>Chrome buttons</h2>
    <div class="row">
      <ChromeButton icon="menu" ariaLabel="Open menu">
        Menu
      </ChromeButton>
      <ChromeButton icon="close" ariaLabel="Close menu">
        Close
      </ChromeButton>
    </div>

    <h2>Language switcher</h2>
    <div class="row">
      <LanguageSwitcher locale="en" path="/privacy" />
      <LanguageSwitcher locale="pl" path="/privacy" />
      <div class="small-switcher">
        <LanguageSwitcher locale="en" path="/privacy" />
      </div>
    </div>

    <h2>Section headings</h2>
    <SectionHeading index="01" eyebrow="EXPERIENCE" title="My journey" />
    <div class="gap"></div>
    <SectionHeading
      index="04"
      eyebrow="GUESTBOOK"
      title="I love connecting people through the power of frontend"
      titleMaxWidth={640}
      align="center"
    />
    <div class="gap"></div>
    <SectionHeading
      index="02"
      eyebrow="PROJECTS"
      title="I’m specializing in making web-apps"
      titleMaxWidth={520}
      as="h3"
    />

    <h2>Highlight</h2>
    <p class="hl-text">
      Designing web-apps in <Highlight>figma</Highlight>, and a long wrapped marker highlight that
      has to clone its padding on every line: <Highlight pad="md">{quote}</Highlight>.
    </p>
    <ul class="grid">
      {PAINT_ORDER.map((id) => (
        <li>
          <span class="hl-text">
            <Highlight tint={id} pad="md">
              {id}
            </Highlight>
          </span>
        </li>
      ))}
    </ul>

    <h2>Spinner and check icon</h2>
    <div class="row icons">
      <Spinner />
      <CheckIcon />
    </div>

    <h2>Paint drips</h2>
    <div class="row">
      {(['top', 'menu', 'bottom', 'modal'] as const).map((variant) => (
        <figure class="stage">
          <PaintDrips variant={variant} />
          <figcaption>{variant}</figcaption>
        </figure>
      ))}
    </div>

    <h2>Cookie icon</h2>
    <div class="row icons">
      <CookieIcon />
    </div>

    <h2>Typing fields</h2>
    <div class="tf-grid">
      <div class="tf-field">
        <label class="tf-label" for="tf-name">
          YOUR NAME
        </label>
        <TypingField
          id="tf-name"
          name="name"
          maxlength={60}
          placeholder="Jane Doe"
          autocomplete="name"
        />
      </div>
      <div class="tf-field">
        <label class="tf-label" for="tf-filled">
          FILLED
        </label>
        <TypingField
          id="tf-filled"
          name="filled"
          maxlength={120}
          placeholder="jane@company.com"
          inputmode="email"
          autocomplete="email"
        />
      </div>
      <div class="tf-field">
        <label class="tf-label" for="tf-error">
          ERROR
        </label>
        <TypingField
          id="tf-error"
          name="error"
          maxlength={120}
          placeholder="jane@company.com"
          inputmode="email"
          autocomplete="email"
          invalid
          describedBy="tf-error-msg"
        />
        <span id="tf-error-msg" class="tf-error" role="alert">
          That email doesn’t look quite right.
        </span>
      </div>
      <div class="tf-field">
        <label class="tf-label" for="tf-disabled">
          DISABLED
        </label>
        <TypingField
          id="tf-disabled"
          name="disabled"
          maxlength={60}
          placeholder="Jane Doe"
          disabled
        />
      </div>
      <div class="tf-field tf-wide">
        <span class="tf-label tf-label-row">
          <label for="tf-message">MESSAGE</label>
          <span id="tf-count">0/1000</span>
        </span>
        <TypingField
          as="textarea"
          id="tf-message"
          name="message"
          maxlength={1000}
          rows={3}
          autoGrow
          placeholder="Tell me a bit about your idea…"
          describedBy="tf-count"
        />
      </div>
      <div class="tf-field tf-wide">
        <span class="tf-label">LONG SINGLE LINE (SCROLLS WITH THE CARET)</span>
        <TypingField
          id="tf-long"
          name="long"
          maxlength={400}
          placeholder=""
          ariaLabel="Long single line"
        />
      </div>
      <div class="tf-field tf-wide">
        <span class="tf-label">BARE (GUESTBOOK ROW OWNS THE LINE)</span>
        <div class="tf-row">
          <div class="tf-row-field">
            <TypingField
              id="tf-bare"
              name="bare"
              maxlength={120}
              variant="bare"
              placeholder="Leave your mark for the next visitor…"
              ariaLabel="Your message"
            />
          </div>
          <span class="tf-counter">36/120</span>
        </div>
      </div>
    </div>
  </main>
</BaseLayout>

<script>
  // Showcase fixtures for the typing fields: values are set like a user would (input events).
  const fill = (id: string, value: string) => {
    const control = document.getElementById(id);
    if (!(control instanceof HTMLInputElement || control instanceof HTMLTextAreaElement)) return;
    control.value = value;
    control.dispatchEvent(new Event('input', { bubbles: true }));
  };
  fill('tf-filled', 'jakub@example.com');
  fill('tf-error', 'jakub@example');
  fill('tf-disabled', 'Jakub Łobos');
  fill('tf-bare', 'Love the paint drips, made me smile!');
  fill(
    'tf-long',
    'Zażółć gęślą jaźń — a deliberately long single line that scrolls horizontally with the caret, so the mirror has to follow it all the way to the end.',
  );
  const message = document.getElementById('tf-message');
  const count = document.getElementById('tf-count');
  message?.addEventListener('input', () => {
    if (message instanceof HTMLTextAreaElement && count) {
      count.textContent = `${message.value.length}/1000`;
    }
  });
</script>

<script>
  // Applies each element's token through the CSSOM (inline style attributes are blocked by CSP).
  for (const el of document.querySelectorAll<HTMLElement>('[data-token]')) {
    const { token, prop } = el.dataset;
    if (token && prop) el.style.setProperty(prop, `var(${token})`);
  }
</script>

<style>
  .showcase {
    padding-block: var(--space-48);
  }
  .display {
    font-family: var(--font-display);
    font-size: var(--text-display);
    line-height: var(--leading-display);
    margin: 0;
  }
  h2 {
    margin-top: var(--space-48);
    font-family: var(--font-mono);
    font-size: var(--text-caption);
    letter-spacing: var(--tracking-label);
    color: var(--color-text-muted);
  }
  .note {
    color: var(--color-text-muted);
  }
  .f-display {
    font-family: var(--font-display);
    font-size: 2.5rem;
  }
  .f-body {
    font-family: var(--font-body);
  }
  .f-500 {
    font-weight: var(--weight-medium);
  }
  .f-600 {
    font-weight: var(--weight-semibold);
  }
  .f-ui {
    font-family: var(--font-ui);
    font-weight: var(--weight-medium);
  }
  .f-mono {
    font-family: var(--font-mono);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: var(--space-16);
    padding: 0;
    list-style: none;
  }
  li {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }
  code {
    font-family: var(--font-mono);
    font-size: var(--text-label);
  }
  .swatch {
    display: block;
    height: 48px;
    border: var(--border-hairline) solid var(--color-line-strong);
    border-radius: var(--radius-md);
  }
  .ramp {
    margin: var(--space-8) 0;
  }
  .space-row {
    display: flex;
    align-items: center;
    gap: var(--space-12);
    margin-block: var(--space-4);
  }
  .bar {
    display: block;
    height: var(--space-12);
    background: var(--color-primary);
  }
  .row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-16);
    padding-bottom: var(--space-8);
  }
  .small-switcher {
    --switcher-size: var(--text-label);
  }
  .icons {
    color: var(--color-ink);
  }
  .gap {
    height: var(--space-32);
  }
  .hl-text {
    font-size: var(--text-lead);
    line-height: var(--leading-lead);
    font-weight: var(--weight-medium);
    max-width: 560px;
  }
  /* The transform makes this the containing block for the fixed "top" strip. */
  .stage {
    position: relative;
    transform: translate(0);
    overflow: hidden;
    width: 340px;
    height: 200px;
    margin: 0;
    background: var(--color-surface);
    border: var(--border-hairline) solid var(--color-line-strong);
  }
  .stage :global([data-variant='top']),
  .stage :global([data-variant='menu']) {
    left: var(--space-16);
  }
  .stage figcaption {
    position: absolute;
    right: var(--space-8);
    top: var(--space-8);
    font-family: var(--font-mono);
    font-size: var(--text-label);
    color: var(--color-text-muted);
  }
  .shape {
    display: block;
    height: 64px;
    background: var(--color-surface);
    border: var(--border-thick) solid var(--color-ink);
  }
  .tf-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
    gap: var(--space-28) var(--space-32);
    max-width: 800px;
  }
  .tf-field {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }
  .tf-wide {
    grid-column: 1 / -1;
  }
  .tf-label {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: var(--tracking-label);
    color: var(--color-text-muted);
  }
  .tf-label-row {
    display: flex;
    justify-content: space-between;
    gap: var(--space-12);
  }
  .tf-error {
    font-size: var(--text-small);
    line-height: var(--leading-field);
    color: var(--color-danger);
  }
  .tf-row {
    display: flex;
    align-items: center;
    gap: var(--space-12);
    padding: var(--space-4) 0;
    border-bottom: var(--border-thick) solid var(--color-ink);
  }
  .tf-row-field {
    flex: 1;
    min-width: 0;
  }
  .tf-counter {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    color: var(--color-text-faint);
  }
</style>
