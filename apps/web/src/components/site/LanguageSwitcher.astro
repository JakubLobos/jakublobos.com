---
import { alternatePath, LOCALES, type Locale } from '../../i18n/locales.ts';

interface Props {
  locale: Locale;
  /** Locale-neutral page path; the link targets its equivalent in the other locale. */
  path: string;
}

const { locale, path } = Astro.props;
const other = LOCALES.find((target) => target !== locale) ?? locale;
---

<!-- STUB: T-023 -->
<a
  href={`/set-language?lang=${other}&to=${alternatePath(other, path)}`}
  lang={other}
  hreflang={other}
  rel="alternate"
>
  {other.toUpperCase()}
</a>
