---
import type { Locale } from '../../i18n/locales.ts';
import { common } from '../../i18n/messages/common.ts';
import { nav } from '../../i18n/messages/nav.ts';
import { EXTERNAL_LINK, SOCIAL_LINKS } from '../../lib/nav.ts';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const labels = nav(locale).social;
---

<aside aria-label={common(locale).socialLinks}>
  <ul>
    {SOCIAL_LINKS.map(({ id, href, external }) => (
      <li>
        <a
          {href}
          {...(external ? EXTERNAL_LINK : {})}
          data-copy-email={id === 'email' || undefined}
        >
          {labels[id]}
        </a>
      </li>
    ))}
  </ul>
</aside>

<style>
  aside {
    position: fixed;
    right: clamp(var(--space-16), 3vw, var(--space-40));
    top: 50%;
    transform: translateY(-50%);
    z-index: var(--z-aside);
    font-size: var(--text-label);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }

  ul {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  a {
    display: block;
    writing-mode: vertical-rl;
    padding: var(--space-12) var(--space-6);
    border-radius: var(--radius-sm);
  }

  a:hover {
    color: var(--color-ink);
    background: var(--color-hover);
  }

  @media (prefers-reduced-motion: no-preference) {
    a {
      transition: background var(--duration-hover) var(--ease-standard);
    }
  }

  /* narrow: no room beside the content. */
  @media (width < 980px) {
    aside {
      display: none;
    }
  }
</style>
