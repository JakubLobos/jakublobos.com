---
import { alternatePath, type Locale } from '../../i18n/locales.ts';
import { cookies } from '../../i18n/messages/cookies.ts';
import CookieIcon from '../decor/CookieIcon.astro';
import Button from '../ui/Button.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const m = cookies(locale);
---

<!-- Hidden until `cookie-consent.ts` shows it: without JS there is no analytics, so no banner. -->
<cookie-banner>
  <div class="banner" role="region" aria-label={m.region} tabindex="-1" hidden>
    <div class="head">
      <CookieIcon />
      <span class="label">{m.label}</span>
    </div>
    <p>
      {m.text} <a href={alternatePath(locale, '/privacy')}>{m.privacy}</a>
    </p>
    <div class="actions">
      <Button size="sm" data-consent="all">
        {m.accept}
      </Button>
      <Button size="sm" variant="secondary" data-consent="essential">
        {m.essentialOnly}
      </Button>
    </div>
  </div>
</cookie-banner>

<script>
  import '../../scripts/cookie-consent.ts';
  import '../../scripts/analytics.ts';
</script>

<style>
  cookie-banner {
    display: contents;
  }

  .banner:not([hidden]) {
    position: fixed;
    inset: auto auto var(--space-24) var(--space-24);
    z-index: var(--z-cookie);
    display: flex;
    flex-direction: column;
    gap: var(--space-14);
    width: min(380px, calc(100vw - 48px));
    padding: var(--space-22) var(--space-22) var(--space-20);
    background: var(--color-surface);
    border: var(--border-thick) solid var(--color-ink);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-card);
    overflow: hidden;
  }

  /* The menu is a full-screen sheet; the banner would sit over it. */
  :global(html[data-menu-open]) .banner {
    display: none;
  }

  /* Programmatic focus (reopened from the footer) shouldn't draw a ring on the card itself. */
  .banner:focus {
    outline: none;
  }

  .head {
    display: flex;
    align-items: center;
    gap: var(--space-12);
  }

  .label {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  p {
    margin: 0;
    font-size: var(--text-small);
    line-height: var(--leading-cookie);
    color: var(--color-text-body);
    text-wrap: pretty;
  }

  p a {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-12);
    padding-top: var(--space-4);
  }

  .actions :global(.btn) {
    flex: 1 1 120px;
  }

  @media (width < 760px) {
    .banner:not([hidden]) {
      inset: auto var(--space-12) var(--space-12) var(--space-12);
      width: auto;
      max-width: 380px;
    }
  }
</style>
