---
import type { Locale } from '../../i18n/locales.ts';
import { common } from '../../i18n/messages/common.ts';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<!-- STUB: T-023 -->
<a href="#top">{common(locale).skipToContent}</a>

<style>
  /* Out of flow so the stub can't shift the page grid; above .page so it shows on focus. */
  a {
    position: absolute;
    top: 0;
    left: 0;
    z-index: var(--z-skip);
  }
</style>
