---
import type { Locale } from '../../i18n/locales.ts';
import { common } from '../../i18n/messages/common.ts';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<a href="#top">{common(locale).skipToContent}</a>

<style>
  /* Parked above the viewport; slides into view on keyboard focus. */
  a {
    position: fixed;
    top: var(--space-12);
    left: var(--space-12);
    z-index: var(--z-skip);
    padding: var(--space-10) var(--space-18);
    font-family: var(--font-ui);
    font-weight: var(--weight-medium);
    font-size: var(--text-body);
    color: var(--color-ink);
    background: var(--color-surface);
    border: var(--border-thick) solid var(--color-ink);
    border-radius: var(--radius-md);
    box-shadow: 0 var(--press-sm-rest) 0 var(--color-ink);
    transform: translateY(calc(-100% - var(--space-24)));
  }

  a:focus-visible {
    transform: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    a {
      transition: transform var(--duration-press) var(--ease-standard);
    }
  }
</style>
