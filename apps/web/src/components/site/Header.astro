---
import type { Locale } from '../../i18n/locales.ts';
import { common } from '../../i18n/messages/common.ts';
import { nav } from '../../i18n/messages/nav.ts';
import ChromeButton from '../ui/ChromeButton.astro';
import DesktopNav from './DesktopNav.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import Logo from './Logo.astro';

interface Props {
  locale: Locale;
  /** Locale-neutral page path, for the nav links and the language switcher. */
  path: string;
}

const { locale, path } = Astro.props;
---

<header data-site-header>
  <Logo locale={locale} {path} />
  <div class="end">
    <DesktopNav locale={locale} {path} />
    <span class="divider" aria-hidden="true"></span>
    <LanguageSwitcher locale={locale} {path} />
  </div>
  <div class="menu-trigger">
    <ChromeButton
      icon="menu"
      ariaLabel={nav(locale).openMenu}
      aria-haspopup="dialog"
      aria-controls="mobile-menu"
      aria-expanded="false"
      data-menu-trigger
    >
      {common(locale).menu}
    </ChromeButton>
  </div>
</header>

<script>
  // D-16: the mobile header turns translucent once the page has scrolled (see the D-16 block below).
  const header = document.querySelector('[data-site-header]');
  const sync = () => {
    if (header) header.toggleAttribute('data-scrolled', window.scrollY > 8);
  };
  window.addEventListener('scroll', sync, { passive: true });
  sync();
</script>

<style>
  header {
    position: sticky;
    top: 0;
    z-index: var(--z-header);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-24);
    padding: var(--header-pad);
  }

  .end {
    display: flex;
    align-items: center;
    gap: var(--space-16);
    /* Aligns the switcher's text, not its pill, with the page gutter. */
    margin-right: calc(-1 * var(--space-10));
  }

  .divider {
    flex: none;
    width: var(--border-hairline);
    height: var(--space-16);
    background: var(--color-line-strong);
  }

  .menu-trigger {
    display: none;
  }

  @media (width < 760px) {
    .end {
      display: none;
    }

    .menu-trigger {
      display: block;
    }
  }

  /* D-16: mobile only. Desktop stays transparent as designed. */
  @media (width < 760px) {
    header {
      border-bottom: var(--border-hairline) solid transparent;
    }

    header:global([data-scrolled]) {
      background: color-mix(in srgb, var(--color-bg) 90%, transparent);
      border-bottom-color: var(--color-line);
      backdrop-filter: blur(6px);
    }
  }
</style>
