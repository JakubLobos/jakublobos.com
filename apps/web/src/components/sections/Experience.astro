---
import { experience } from '../../content/experience.ts';
import type { Locale } from '../../i18n/locales.ts';
import { experience as messages } from '../../i18n/messages/experience.ts';
import SectionHeading from '../ui/SectionHeading.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const m = messages(locale);
const entries = experience.map((entry) => ({
  ...entry,
  ...entry.copy[locale],
  kindLabel: m.kind[entry.kind],
  panelId: `experience-${entry.id}`,
}));
---

<!--
  The markup is the compact layout (every entry stacked, meta `KIND · DATE`), which is also the
  no-JS baseline. The rail is hidden until scripts/experience-timeline.ts switches the
  element to data-mode="sticky".
-->
<section id="experience" aria-labelledby="experience-heading">
  <experience-timeline>
    <div class="stage">
      <SectionHeading id="experience-heading" index="01" eyebrow={m.eyebrow} title={m.title} />
      <div class="body">
        <div class="rail" role="group" aria-label={m.timeline}>
          <span class="fill" aria-hidden="true"></span>
          {entries.map((entry) => (
            <button
              type="button"
              class="step"
              data-step
              data-paint={entry.paint}
              aria-controls={entry.panelId}
            >
              <span class="dot" aria-hidden="true" />
              <span class="date">{entry.date}</span>
              <span class="org">{entry.org}</span>
            </button>
          ))}
        </div>
        <div class="panels">
          {entries.map((entry) => (
            <article class="panel" id={entry.panelId} data-panel data-paint={entry.paint}>
              <span class="meta">
                {entry.kindLabel}
                <span class="meta-date"> · {entry.date}</span>
              </span>
              <div class="titles">
                <h3>{entry.title}</h3>
                <p>{entry.sub}</p>
              </div>
              {entry.bullets.length > 0 && (
                <ul>
                  {entry.bullets.map((bullet) => (
                    <li>{bullet}</li>
                  ))}
                </ul>
              )}
            </article>
          ))}
        </div>
      </div>
    </div>
  </experience-timeline>
</section>

<script>
  import '../../scripts/experience-timeline.ts';
</script>

<style>
  experience-timeline {
    /* Geometry of the rail illustration (design-analysis §4.8). */
    --rail-col: 280px;
    --rail-inset: 8px;
    --track-x: 5px;
    --fill-x: 4px;
    --fill-w: 3px;
    --fill-radius: 2px;
    --fill-duration: 80ms;
    --dot-size: 11px;
    --dot-scale: 1.3;
    --panel-max: 600px;

    display: block;
  }

  [data-paint='red'] {
    --entry: var(--paint-red);
    --entry-text: var(--paint-red-text);
  }
  [data-paint='coral'] {
    --entry: var(--paint-coral);
  }
  [data-paint='yellow'] {
    --entry: var(--paint-yellow);
  }
  [data-paint='purple'] {
    --entry: var(--paint-purple);
  }
  [data-paint='violet'] {
    --entry: var(--paint-violet);
    --entry-text: var(--paint-violet-text);
  }
  [data-paint='blue'] {
    --entry: var(--paint-blue);
    --entry-text: var(--paint-blue-text);
  }

  .stage {
    display: flex;
    flex-direction: column;
    gap: var(--space-48);
    padding-block: var(--space-exp-stage);
  }

  .body {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-exp-cols);
    align-items: start;
  }

  .panels {
    display: grid;
    gap: var(--space-56);
  }

  .panel {
    display: flex;
    flex-direction: column;
    gap: var(--space-16);
  }

  .meta {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: var(--tracking-label);
    color: var(--entry-text);
  }

  .titles {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  h3 {
    margin: 0;
    font-size: var(--text-h3);
    font-weight: var(--weight-medium);
    line-height: var(--leading-h3);
  }

  .titles p {
    margin: 0;
    font-size: var(--text-small);
    color: var(--color-text-muted);
  }

  ul {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
    max-width: var(--panel-max);
    margin: 0;
    padding: 0 0 0 var(--space-18);
    font-size: var(--text-body);
    line-height: var(--leading-body);
    color: var(--color-text-body);
  }

  .rail {
    display: none;
  }

  /*
   * Sticky mode: the element is the tall scroll track, the stage is pinned inside it.
   * data-mode and data-position are set at runtime, so they are :global() to keep the unused-
   * selector lint (which only sees the template) from flagging them.
   */
  experience-timeline:global([data-mode='sticky']) {
    height: calc(var(--exp-count) * 80vh + 20vh);
  }

  :global([data-mode='sticky']) .stage {
    position: sticky;
    top: 0;
    height: 100vh;
    justify-content: center;
  }

  :global([data-mode='sticky']) .body {
    grid-template-columns: minmax(0, var(--rail-col)) minmax(0, 1fr);
  }

  :global([data-mode='sticky']) .meta-date {
    display: none;
  }

  :global([data-mode='sticky']) .panel {
    grid-area: 1 / 1;
  }

  /* Inactive panels stay in the accessibility tree; they are only visually hidden. */
  :global([data-mode='sticky']) .panel:global([data-position='before']),
  :global([data-mode='sticky']) .panel:global([data-position='after']) {
    opacity: 0;
    pointer-events: none;
  }

  :global([data-mode='sticky']) .rail {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-36);
    padding-left: var(--space-32);
  }

  .rail::before {
    content: '';
    position: absolute;
    left: var(--track-x);
    top: var(--rail-inset);
    bottom: var(--rail-inset);
    width: var(--border-hairline);
    background: var(--color-line-strong);
  }

  .fill {
    position: absolute;
    left: var(--fill-x);
    top: var(--rail-inset);
    width: var(--fill-w);
    height: calc((100% - 2 * var(--rail-inset)) * var(--exp-fill, 0));
    border-radius: var(--fill-radius);
    background: var(--color-ink);
  }

  .step {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: 0;
    border: 0;
    background: none;
    font-family: var(--font-body);
    text-align: left;
    color: var(--color-text-muted);
    cursor: pointer;
  }

  .step:global([data-position='active']) {
    color: var(--color-ink);
  }

  .date {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: var(--tracking-date);
  }

  .org {
    font-size: var(--text-field);
    font-weight: var(--weight-medium);
    line-height: var(--leading-title);
  }

  .dot {
    position: absolute;
    left: calc(-1 * var(--space-32));
    top: var(--space-4);
    width: var(--dot-size);
    height: var(--dot-size);
    border: var(--border-thick) solid var(--entry);
    border-radius: 50%;
    background: var(--color-bg);
    box-shadow: 0 0 0 var(--space-4) var(--color-bg);
  }

  .step:global([data-position='before']) .dot,
  .step:global([data-position='active']) .dot {
    background: var(--entry);
  }

  .step:global([data-position='active']) .dot {
    transform: scale(var(--dot-scale));
  }

  @media (prefers-reduced-motion: no-preference) {
    .fill {
      transition: height var(--fill-duration) linear;
    }

    .step {
      transition: color var(--duration-state) var(--ease-standard);
    }

    .dot {
      transition:
        transform var(--duration-state) var(--ease-standard),
        background var(--duration-state) var(--ease-standard);
    }

    :global([data-mode='sticky']) .panel {
      transition:
        opacity var(--duration-panel) var(--ease-standard),
        transform var(--duration-panel) var(--ease-standard);
    }

    :global([data-mode='sticky']) .panel:global([data-position='before']) {
      transform: translateY(calc(-1 * var(--space-16)));
    }

    :global([data-mode='sticky']) .panel:global([data-position='after']) {
      transform: translateY(var(--space-16));
    }
  }

  /* Colour carries the state in the design; these cues keep it readable without colour. */
  @media (forced-colors: active) {
    .rail::before {
      background: GrayText;
    }

    .fill {
      background: CanvasText;
    }

    .dot {
      border-color: CanvasText;
    }

    .step:global([data-position='before']) .dot,
    .step:global([data-position='active']) .dot {
      background: CanvasText;
    }

    .step:global([data-position='active']) .org {
      text-decoration: underline;
      text-underline-offset: var(--space-4);
    }
  }
</style>
