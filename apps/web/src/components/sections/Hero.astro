---
import type { Locale } from '../../i18n/locales.ts';
import { hero } from '../../i18n/messages/hero.ts';
import { profile } from '../../content/profile.ts';
import Mascot from '../decor/Mascot.astro';
import Button from '../ui/Button.astro';
import Highlight from '../ui/Highlight.astro';
import '../../styles/motion/hero.css';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = hero(locale);

// Empty (e.g. local development) switches the download to its fake flow.
const configuredKey: unknown = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
const siteKey = typeof configuredKey === 'string' ? configuredKey : '';
---

<section id="hero" class="hero" aria-labelledby="hero-heading">
  <div class="sticker">
    <Mascot />
  </div>
  <h1 id="hero-heading" class="title">
    {t.title}
  </h1>
  <p class="intro">
    {t.intro.before}
    <span class="tech">{t.intro.build}</span>
    {t.intro.join}
    <Highlight>{t.intro.design}</Highlight>
    {t.intro.after}
  </p>
  <div class="divider" aria-hidden="true"></div>
  <div class="actions">
    <Button href="#contact">{t.contact}</Button>
    <resume-download data-locale={locale} data-site-key={siteKey}>
      <Button variant="secondary" data-resume>
        {t.resume}
      </Button>
      <span class="nojs">
        {t.resumeNoScript} <a href={`mailto:${profile.email}`}>{profile.email}</a>
      </span>
      <div class="feedback">
        <p class="status" data-status aria-live="polite"></p>
        <div class="widget" data-widget></div>
      </div>
    </resume-download>
  </div>
</section>

<script>
  import '../../scripts/resume-download.ts';
</script>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-28);
    min-height: calc(100svh - 240px);
    padding: var(--space-40) 0 var(--space-32);
    text-align: center;
  }

  .title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: var(--weight-regular);
    font-size: var(--text-display);
    line-height: var(--leading-display);
    text-wrap: balance;
  }

  .intro {
    max-width: var(--intro-max);
    margin: 0;
    font-size: var(--text-lead);
    line-height: var(--leading-lead);
    text-wrap: balance;
  }

  .tech {
    color: var(--color-tech);
    font-weight: var(--weight-medium);
  }

  .divider {
    width: var(--divider-w);
    height: var(--border-hairline);
    background: var(--color-line-strong);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-16);
    padding-top: var(--space-8);
    position: relative;
  }

  /* Out of flow, so a status line or an interactive challenge never moves the hero. */
  .feedback {
    position: absolute;
    inset: 100% 0 auto;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-8);
    padding-top: var(--space-16);
  }

  .status {
    margin: 0;
    font-size: var(--text-caption);
    line-height: var(--leading-caption);
    color: var(--color-text-muted);
  }

  .status:empty,
  .widget:empty {
    display: none;
  }

  .nojs {
    display: none;
    max-width: var(--intro-max);
    font-size: var(--text-caption);
    line-height: var(--leading-caption);
    color: var(--color-text-muted);
  }

  /* Without scripting the download can't work, so say where to go instead of a dead button. */
  @media (scripting: none) {
    resume-download :global([data-resume]) {
      display: none;
    }

    .nojs {
      display: block;
    }
  }

  /* Entrance: the hero is stuck, inked and drawn onto the page like a sheet of paper. Backwards
     fill leaves no animated value behind, so the buttons and mascot keep their own hover
     transforms. The h1 never starts at opacity 0 because it is the LCP candidate. */
  @media (prefers-reduced-motion: no-preference) {
    .sticker {
      animation: hero-stick var(--duration-enter) var(--ease-spring) backwards;
    }

    .title {
      animation: hero-ink var(--duration-ink) var(--ease-ink) backwards;
    }

    .intro {
      animation: hero-settle var(--duration-enter) var(--ease-out) calc(var(--stagger-enter) * 4)
        backwards;
    }

    .intro :global(.hl) {
      background-repeat: no-repeat;
      animation: hero-swipe var(--duration-enter) var(--ease-out) calc(var(--stagger-enter) * 7)
        backwards;
    }

    .divider {
      animation: hero-draw var(--duration-enter) var(--ease-out) calc(var(--stagger-enter) * 6)
        backwards;
    }

    .actions > :global(*) {
      animation: hero-place var(--duration-enter) var(--ease-spring) calc(var(--stagger-enter) * 8)
        backwards;
    }

    .actions > :global(:nth-child(2)) {
      animation-delay: calc(var(--stagger-enter) * 9);
    }
  }
</style>
