---
// The hero's sketched 3D city (D-37). Decorative only: the canvas is drawn by scripts/paper-city.ts,
// which paper-city-loader.ts fetches after the page has loaded. Without it the hero keeps the grid.
---

<div class="city" aria-hidden="true">
  <paper-city></paper-city>
  <div class="tilt"></div>
</div>

<script>
  import '../../scripts/paper-city-loader.ts';
</script>

<style>
  /* Full viewport width behind the hero; the bottom fades out into the skill bands. */
  .city {
    position: absolute;
    z-index: -1;
    top: calc(var(--hero-city-bleed-top) * -1);
    bottom: calc(var(--hero-city-bleed-bottom) * -1);
    left: 50%;
    width: 100vw;
    transform: translateX(-50%);
    pointer-events: none;
    mask-image: linear-gradient(to bottom, #000 84%, transparent);
  }

  paper-city {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity var(--duration-city-fade) var(--ease-out);
  }

  /* scripts/paper-city.ts sets data-ready after the first frame. */
  paper-city:global([data-ready]) {
    opacity: 1;
  }

  paper-city > :global(canvas) {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
  }

  /* A light tilt-shift on the nearest street. Phones skip it: blurring a live canvas is costly. */
  .tilt {
    display: none;
  }

  @media (width >= 760px) {
    .tilt {
      position: absolute;
      inset: auto 0 0;
      display: block;
      height: 26%;
      backdrop-filter: blur(var(--hero-city-blur));
      mask-image: linear-gradient(to top, #000 20%, transparent);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    paper-city {
      transition: none;
    }
  }

  @media (forced-colors: active), print {
    .city {
      display: none;
    }
  }
</style>
