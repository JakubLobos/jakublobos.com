---
// "In review" confirmation, a native modal <dialog> (focus trap, inert page and Escape come from the
// browser). scripts/guestbook-form.ts opens it, writes the echoed text with `textContent` and sets
// its tint; it closes on "Got it", Escape or a click outside the card.
import type { Locale } from '../../i18n/locales.ts';
import { guestbook } from '../../i18n/messages/guestbook.ts';
import PaintDrips from '../decor/PaintDrips.astro';
import Button from '../ui/Button.astro';
import Highlight from '../ui/Highlight.astro';

interface Props {
  locale: Locale;
  id: string;
}

const { locale, id } = Astro.props;
const m = guestbook(locale);
const titleId = `${id}-title`;
---

<dialog
  {id}
  class="modal"
  aria-labelledby={titleId}
  data-guestbook-modal
  data-messages={JSON.stringify(m.status)}
>
  <div class="card" data-state="checking" data-card>
    <PaintDrips variant="modal" />
    <span class="eyebrow" data-status-eyebrow>
      {m.status.checking.eyebrow}
    </span>
    <h3 id={titleId} class="title" data-status-title>
      {m.status.checking.title}
    </h3>
    <p class="echo">
      <Highlight>
        <span data-echo-text></span>
      </Highlight>
    </p>
    <!-- Brush stroke: sweeps while the review runs, fills when approved, empty otherwise. The
         track keeps its place in every state so nothing shifts when the outcome arrives. -->
    <div class="progress" aria-hidden="true" data-progress>
      <span class="stroke"></span>
    </div>
    <p class="copy" data-status-copy>
      {m.status.checking.body}
    </p>
    <!-- Screen readers hear each state change here; the visible texts above are not live. -->
    <p class="visually-hidden" role="status" aria-live="polite" data-status-live></p>
    <Button type="button" data-modal-close>
      {m.modal.close}
    </Button>
  </div>
</dialog>

<style>
  /* No scroll while the dialog is open; the page scrollbar is hidden site-wide, so nothing shifts. */
  :global(html:has([data-guestbook-modal][open])) {
    overflow: hidden;
  }

  .modal {
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: var(--space-24);
    color: var(--color-ink);
    background: transparent;
    border: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .modal:modal {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .modal::backdrop {
    background: var(--color-overlay);
  }

  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-20);
    width: 100%;
    max-width: var(--guestbook-modal-max);
    margin: auto;
    padding: var(--space-40) var(--space-32) var(--space-32);
    text-align: center;
    background: var(--color-surface);
    border: var(--border-thick) solid var(--color-ink);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-dialog);
    overflow: hidden;
  }

  .eyebrow {
    /* Clears the drips hanging from the top edge. */
    margin-top: var(--space-28);
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: var(--tracking-label);
    color: var(--color-text-muted);
  }

  .title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: var(--weight-regular);
    font-size: var(--text-dialog-title);
    line-height: var(--leading-heading);
  }

  .echo {
    margin: 0;
    font-size: var(--text-modal-quote);
    line-height: var(--leading-modal-quote);
    font-weight: var(--weight-medium);
    overflow-wrap: anywhere;
    text-wrap: balance;
  }

  /* Texts of different states differ in length; reserving the tallest keeps the card from jumping. */
  .title {
    display: flex;
    align-items: center;
    justify-content: center;
    min-block-size: 2lh;
  }

  .progress {
    --tint: var(--paint-yellow-tint);

    width: 100%;
    max-width: var(--guestbook-modal-copy-max);
    height: var(--space-12);
    overflow: hidden;
    border: var(--border-thick) solid var(--color-ink);
    border-radius: var(--radius-lg);
  }

  .stroke {
    display: block;
    width: 100%;
    height: 100%;
    background: var(--tint);
    border-radius: inherit;
    transform-origin: left center;
    transition: transform var(--duration-panel) var(--ease-standard);
  }

  /* `data-state` is set by the script, so the lint rule can't see it in the markup. */
  .card:global([data-state='checking']) .stroke,
  .card:global([data-state='slow']) .stroke {
    transform: scaleX(0.45);
  }

  .card:global([data-state='rejected']) .stroke,
  .card:global([data-state='superseded']) .stroke {
    transform: scaleX(0);
  }

  .card:global([data-state='approved']) .stroke {
    transform: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    .card:global([data-state='checking']) .stroke {
      animation: brush calc(var(--duration-panel) * 4) var(--ease-standard) infinite;
    }
  }

  @media (forced-colors: active) {
    .stroke {
      background: Highlight;
    }
  }

  .copy {
    max-width: var(--guestbook-modal-copy-max);
    min-block-size: 3lh;
    margin: 0;
    font-size: var(--text-small);
    line-height: var(--leading-small);
    color: var(--color-text-secondary);
  }

  .card :global(.btn) {
    margin-top: var(--space-8);
    padding-inline: var(--space-28);
  }
</style>
