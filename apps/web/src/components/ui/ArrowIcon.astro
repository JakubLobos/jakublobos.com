---
interface Props {
  direction: 'up' | 'up-right';
}

const paths = {
  up: 'M12 19V5M6 11l6-6 6 6',
  'up-right': 'M7 17L17 7M8 7h9v9',
} as const;

const { direction } = Astro.props;
---

<svg
  class="arrow"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  <path d={paths[direction]}></path>
</svg>

<style>
  .arrow {
    display: inline-block;
    flex: none;
    width: var(--icon-arrow);
    height: var(--icon-arrow);
    margin-inline-start: var(--space-4);
    vertical-align: -0.1em;
  }
</style>
