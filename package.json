{
  "name": "portfolio",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Jakub Łobos portfolio — Astro static site + Express API (guestbook with moderation, contact form).",
  "engines": {
    "node": ">=24.11.0",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@11.4.0",
  "scripts": {
    "dev": "pnpm --recursive --parallel --filter \"./apps/*\" dev",
    "build": "pnpm --recursive build",
    "preview": "pnpm --filter @portfolio/web run build:preview && pnpm --parallel --filter @portfolio/web --filter @portfolio/server run preview:topology",
    "start": "pnpm --filter @portfolio/server start",
    "typecheck": "pnpm --recursive typecheck && tsc -p tsconfig.json && tsc -p e2e/tsconfig.json",
    "sync": "pnpm --filter @portfolio/web exec astro sync",
    "lint": "pnpm sync && eslint .",
    "lint:fix": "pnpm sync && eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm --recursive test",
    "og:generate": "node tools/og/render-og.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@typescript-eslint/parser": "8.72.0",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-astro": "3.2.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0"
  }
}
